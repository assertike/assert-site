{
	email {$ACME_EMAIL}
}

# Redirect www to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Uploads can be up to 16 MB (matches MAX_CONTENT_LENGTH in the app).
	request_body {
		max_size 17MB
	}

	reverse_proxy app:8000
}
