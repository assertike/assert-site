# Copy to .env and fill in before running `docker compose up`.

# Public domain served by Caddy (use "localhost" to try the stack locally).
DOMAIN=assert.gr
# Email for Let's Encrypt certificate notices.
ACME_EMAIL=info@assert.gr

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional
# GUNICORN_THREADS=8
# LOG_LEVEL=info
